# ---- Corpus data -------------------------------------------------------
# data/ holds the raw OpenSubtitles download (pt.txt.gz, ~1.1 GB).
# It must never be committed. See DATA_SOURCES.md for how to fetch it.
data/

# ---- Python ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ---- Editors / IDEs ----------------------------------------------------
.vscode/
*.code-workspace
.idea/

# ---- Claude Code -------------------------------------------------------
.claude-account
.claude/settings.local.json

# ---- macOS -------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Pipeline intermediates (pass-1/pass-2 caches)
.cache/

# Stage 1 baseline and --sample runs (python -m scripts.build --stage 1 /
# --sample N). Only the release build's out/ and reports/ are committed.
build/

# Full proper-noun drop log: ~260k entries / 10 MB of mostly hapax noise.
# The truncated dropped_proper_nouns.txt is committed instead.
*_full.txt

# Secrets: the API key is read from the environment (ANTHROPIC_API_KEY) and
# must never be written to a file.
.env
.env.*
*.key

# Raw model responses for the glosses, keyed by lemma + POS. Regenerating a
# row is free while these are here; the published glosses live in
# out/glosses.tsv, which is committed.
cache/
_to_delete/

# Certificates and key files, and anything in a secrets folder. None of these
# are used by this project today; the lines are here so they can never be
# committed by accident.
*.pem
*.p12
*.p8
secrets/
